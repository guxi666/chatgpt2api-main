# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================

# 认证密钥（必填）
CHATGPT2API_AUTH_KEY=your_secret_key_here

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# 运行镜像（默认拉取你二开仓库产出的 GHCR 镜像）
# CHATGPT2API_RUNTIME_IMAGE=ghcr.io/guxi666/chatgpt2api:latest

# 镜像拉取策略（always / missing / never）
# CHATGPT2API_PULL_POLICY=always

# 全局代理（可选，支持 http/https/socks5/socks5h）
# CHATGPT2API_PROXY=http://127.0.0.1:7890

# 限流账号检查间隔，单位：分钟
CHATGPT2API_REFRESH_ACCOUNT_INTERVAL_MINUTE=5

# 同时生成图片张数限制
CHATGPT2API_IMAGE_CONCURRENT_LIMIT=4

# 普通用户默认同时处理图片张数限制，0 表示不限制
CHATGPT2API_USER_DEFAULT_CONCURRENT_LIMIT=0

# 普通用户默认图片任务 RPM 限制，0 表示不限制
CHATGPT2API_USER_DEFAULT_RPM_LIMIT=0

# 服务端缓存图片保留天数
CHATGPT2API_IMAGE_RETENTION_DAYS=30

# 自动移除失效账号
CHATGPT2API_AUTO_REMOVE_INVALID_ACCOUNTS=true

# 自动移除限流账号
CHATGPT2API_AUTO_REMOVE_RATE_LIMITED_ACCOUNTS=false

# 记录日志级别，多个值用英文逗号分隔：debug,info,warning,error
# CHATGPT2API_LOG_LEVELS=warning,error

# ============================================
# Linuxdo 登录配置（可选）
# ============================================

# 启用 Linuxdo Connect 登录
# CHATGPT2API_LINUXDO_ENABLED=false

# Linuxdo Connect 应用凭据
# CHATGPT2API_LINUXDO_CLIENT_ID=
# CHATGPT2API_LINUXDO_CLIENT_SECRET=

# 后端 OAuth 回调地址；Linuxdo Connect 应用后台也必须填写这个后端地址。
# 如未设置且 CHATGPT2API_BASE_URL 已设置，会默认使用：
# ${CHATGPT2API_BASE_URL}/auth/linuxdo/oauth/callback
# CHATGPT2API_LINUXDO_REDIRECT_URL=https://your-domain.com/auth/linuxdo/oauth/callback

# 前端接收本地会话密钥的路由；不要填到 Linuxdo Connect 应用后台。
# CHATGPT2API_LINUXDO_FRONTEND_REDIRECT_URL=/auth/linuxdo/callback

# Linuxdo Connect 端点，通常无需修改
# CHATGPT2API_LINUXDO_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
# CHATGPT2API_LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
# CHATGPT2API_LINUXDO_USERINFO_URL=https://connect.linux.do/api/user
# CHATGPT2API_LINUXDO_SCOPES=user

# ============================================
# 邮箱注册与计费（可选）
# ============================================

# 允许注册的邮箱域名（英文逗号分隔）
# CHATGPT2API_EMAIL_ALLOWED_DOMAINS=qq.com,163.com,126.com,gmail.com,outlook.com,hotmail.com,icloud.com,yahoo.com,foxmail.com,sina.com

# 单次生图扣费（单位：分，默认 8，即 0.08 元）
# CHATGPT2API_IMAGE_PRICE_CENTS=8

# ============================================
# 邮件发信 SMTP 配置（可选，推荐 QQ 邮箱）
# ============================================

# 启用 SMTP 发信
# CHATGPT2API_EMAIL_SMTP_ENABLED=false

# QQ 邮箱 SMTP 推荐配置
# CHATGPT2API_EMAIL_SMTP_HOST=smtp.qq.com
# CHATGPT2API_EMAIL_SMTP_PORT=465
# CHATGPT2API_EMAIL_SMTP_USE_SSL=true

# 发信账号（通常与发件邮箱一致）
# CHATGPT2API_EMAIL_SMTP_USERNAME=your_account@qq.com

# 授权码（不是邮箱登录密码）
# CHATGPT2API_EMAIL_SMTP_AUTH_CODE=your_qq_smtp_auth_code

# 发件人邮箱/名称
# CHATGPT2API_EMAIL_SMTP_FROM_EMAIL=your_account@qq.com
# CHATGPT2API_EMAIL_SMTP_FROM_NAME=chatgpt2api

# ============================================
# 易支付配置（可选）
# ============================================

# 启用易支付
# CHATGPT2API_YIPAY_ENABLED=false

# 商户 PID 与密钥
# CHATGPT2API_YIPAY_PID=
# CHATGPT2API_YIPAY_KEY=

# 提交支付地址（通常为 submit.php 的完整 URL）
# CHATGPT2API_YIPAY_SUBMIT_URL=https://pay.example.com/submit.php

# 异步回调地址（可选，不填时默认 /api/pay/yipay/notify）
# CHATGPT2API_YIPAY_NOTIFY_URL=https://your-domain.com/api/pay/yipay/notify

# 同步返回地址（可选）
# CHATGPT2API_YIPAY_RETURN_URL=https://your-domain.com/image

# 展示站点名称（可选）
# CHATGPT2API_YIPAY_SITE_NAME=chatgpt2api

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres, git）
# 默认: sqlite
STORAGE_BACKEND=sqlite

# ============================================
# 数据库配置（当 STORAGE_BACKEND=sqlite/postgres 时使用）
# ============================================

# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例（容器内绝对路径需要四个斜杠；不指定时自动使用 data/chatgpt2api.db）
# DATABASE_URL=sqlite:////app/data/chatgpt2api.db

# ============================================
# Git 仓库配置（当 STORAGE_BACKEND=git 时使用）
# ============================================

# Git 仓库地址（必填）
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git

# Git 访问令牌（必填）
# GitHub: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitLab: glpat-xxxxxxxxxxxxxxxxxxxx
# GIT_TOKEN=your_git_token_here

# Git 分支（可选，默认: main）
# GIT_BRANCH=main

# Git 仓库中的文件路径（可选，默认: accounts.json）
# GIT_FILE_PATH=accounts.json

# ============================================
# PayPal 配置（可选）
# ============================================

# 启用 PayPal 支付
# CHATGPT2API_PAYPAL_ENABLED=false

# PayPal 收款页 URL（启用时必填）
# CHATGPT2API_PAYPAL_CHECKOUT_URL=https://www.paypal.com/paypalme/yourname

# ============================================
# USDT 配置（可选）
# ============================================

# 启用 USDT 支付
# CHATGPT2API_USDT_ENABLED=false

# USDT 网络（如 TRC20 / ERC20）
# CHATGPT2API_USDT_NETWORK=TRC20

# USDT 收款地址（启用时必填）
# CHATGPT2API_USDT_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDT 支付页 URL（可选）
# CHATGPT2API_USDT_PAYMENT_URL=https://pay.example.com/usdt

# ============================================
# Cloudflare R2 image storage (optional)
# ============================================
# Enable uploading generated images to Cloudflare R2.
# CHATGPT2API_IMAGE_R2_ENABLED=false

# R2 S3 API endpoint, for example:
# https://<account_id>.r2.cloudflarestorage.com
# CHATGPT2API_IMAGE_R2_ENDPOINT=

# R2 bucket name and API token credentials.
# CHATGPT2API_IMAGE_R2_BUCKET=
# CHATGPT2API_IMAGE_R2_ACCESS_KEY_ID=
# CHATGPT2API_IMAGE_R2_SECRET_ACCESS_KEY=

# R2 uses region auto by default.
# CHATGPT2API_IMAGE_R2_REGION=auto

# Required when R2 is enabled. Uploaded images use this public domain and local originals are deleted after successful upload.
# CHATGPT2API_IMAGE_R2_PUBLIC_BASE_URL=

# Object key prefix inside the bucket.
# CHATGPT2API_IMAGE_R2_PREFIX=images

# ============================================
# Secondary Cloudflare R2 image storage (optional)
# ============================================
# Fallback target before primary R2 when external image bed fails.
# CHATGPT2API_IMAGE_R2_SECONDARY_ENABLED=false
# CHATGPT2API_IMAGE_R2_SECONDARY_ENDPOINT=
# CHATGPT2API_IMAGE_R2_SECONDARY_BUCKET=
# CHATGPT2API_IMAGE_R2_SECONDARY_ACCESS_KEY_ID=
# CHATGPT2API_IMAGE_R2_SECONDARY_SECRET_ACCESS_KEY=
# CHATGPT2API_IMAGE_R2_SECONDARY_REGION=auto
# CHATGPT2API_IMAGE_R2_SECONDARY_PUBLIC_BASE_URL=
# CHATGPT2API_IMAGE_R2_SECONDARY_PREFIX=images

# ============================================
# External image bed (optional)
# ============================================
# First upload target for generated images.
# CHATGPT2API_IMAGE_IMGBED_ENABLED=false
# CHATGPT2API_IMAGE_IMGBED_UPLOAD_URL=
# CHATGPT2API_IMAGE_IMGBED_AUTH_CODE=
# CHATGPT2API_IMAGE_IMGBED_UPLOAD_CHANNEL=cfr2
